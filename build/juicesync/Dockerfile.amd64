FROM alpine:3.22.2 AS download
RUN apk add --no-cache ca-certificates curl
COPY build/juicesync/download.sh /tmp/download.sh
RUN sh /tmp/download.sh amd64

FROM alpine:3.22.2
RUN apk add --no-cache ca-certificates
COPY --from=download /opt/juicefs /opt/juicefs
ENV JUICEFS_VERSION=1.2.0
COPY build/juicesync/juicesync build/juicesync/sync_hwameistor_volumes.sh build/juicesync/sync_hwameistor_volumes_check.sh /usr/bin/
RUN chmod +x /usr/bin/juicesync /usr/bin/sync_hwameistor_volumes*.sh
